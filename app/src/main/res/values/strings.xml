    <!-- Help & Support (MVP) -->
    <string name="help_section_faq">Frequently Asked</string>
    <string name="help_faq1_q">How does Nova estimate my calories?</string>
    <string name="help_faq1_a">Nova combines your logged meals with your activity to estimate daily calories in and out.</string>
    <string name="help_faq2_q">Can I change my goals later?</string>
    <string name="help_faq2_a">Yes — open Profile → Goals and tap any target to adjust it at any time.</string>
    <string name="help_faq3_q">Does the app work offline?</string>
    <string name="help_faq3_a">Yes. All tracking works offline; AI features will need a connection when they arrive.</string>
    <string name="help_faq4_q">How do streaks work?</string>
    <string name="help_faq4_a">Complete at least one healthy habit each day to keep your streak alive.</string>
