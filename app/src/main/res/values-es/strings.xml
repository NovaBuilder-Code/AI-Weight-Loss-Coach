    <string name="placeholder_calorie_tracker_title">Control de calorías</string>
    <string name="placeholder_calorie_tracker_sub">Registra cada comida, snack y bebida. Busca entre millones de alimentos o escanea códigos de barras para obtener desgloses nutricionales al instante y seguimiento de macros.</string>
    <string name="placeholder_meal_suggestions_title">Sugerencias de comidas</string>
    <string name="placeholder_meal_suggestions_sub">Recibe ideas de comidas personalizadas de Nova AI según tu presupuesto calórico, objetivos de macros, preferencias dietéticas y lo que ya tienes en la nevera.</string>
    <string name="placeholder_food_scan_title">Escaneo de comida con IA</string>
    <string name="placeholder_food_scan_sub">Apunta tu cámara a cualquier comida y Nova AI identificará ingredientes, estimará porciones y registrará tus calorías de forma instantánea, sin entrada manual.</string>
    <string name="placeholder_streaks_title">Rachas diarias</string>
