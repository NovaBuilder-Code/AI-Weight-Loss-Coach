    <string name="chat_send_cd">Send</string>
    <string name="chat_initial_message">Hei! Jeg er Nova, din personlige AI-helsecoach. Jeg er her for å hjelpe deg å nå målene dine – ernæring, trening, vekt og mer. Hva kan jeg hjelpe deg med i dag?</string>
    <string name="chat_quick_dinner">Hva bør jeg spise til middag?</string>
    <string name="chat_quick_on_track">Er jeg på rett spor i dag?</string>
    <string name="chat_quick_workout">Foreslå en treningsøkt</string>
    <string name="chat_quick_protein">Hvor mye protein trenger jeg?</string>
    <string name="chat_quick_calories">Analyser kaloriene mine</string>
    <string name="chat_ai_response_1">Godt spørsmål! Basert på kaloriinntaket ditt i dag ville et proteinrikt middagsmåltid være ideelt. Prøv grillet kyllingbryst med quinoa og ovnsbakte grønnsaker — ca. 500 kcal og 40 g protein.</string>
    <string name="chat_ai_response_2">Du gjør det bra! Du har spist 1 420 kcal av 2 000 kcal-målet ditt. Du har 580 kcal igjen og har forbrent 340 gjennom gåing. Fortsett slik!</string>
    <string name="chat_ai_response_3">For i dag vil jeg foreslå en 30-minutters moderat gåtur — du har allerede gått 7 240 skritt og er nær 10 000-målet ditt. Eller prøv en 20-minutters yogaøkt for å slappe av.</string>
    <string name="chat_ai_response_4">Basert på vekten og aktivitetsnivået ditt trenger du omtrent 130–150 g protein daglig. Gode kilder inkluderer kylling, egg, gresk yoghurt og belgfrukter.</string>
    <string name="chat_ai_response_5">Makroene dine ser balanserte ut i dag. Protein er på 61 %, karbohydrater 72 % og fett 68 % av målene dine. Protein kan gjerne økes litt — legg til en snack som cottage cheese eller en proteinshake.</string>

