    <string name="placeholder_goals_title">Mål</string>
    <string name="placeholder_goals_sub">Sæt og administrer dit vægtmål, daglige kaloribudget, skridt-mål og makrofordeling for at holde din Nova AI-coaching på rette spor.</string>
    <string name="placeholder_notifications_title">Notifikationer</string>
    <string name="placeholder_notifications_sub">Tilpas måltidspåmindelser, skridt-mål-alarmer, vejepåmindelser og daglige motivationsmeddelelser fra Nova AI.</string>
    <string name="placeholder_privacy_title">Privatliv</string>
    <string name="placeholder_privacy_sub">Kontroller dine datatilladelser, administrer hvad Nova AI lærer om dig, og gennemgå vores datapraksis og privatlivspolitik.</string>
    <string name="placeholder_help_title">Hjælp og support</string>
    <string name="placeholder_help_sub">Gennemse FAQ, se instruktionsvideoer, eller kontakt vores supportteam. Vi er her for at hjælpe dig med at få mest muligt ud af Nova AI.</string>
    <string name="placeholder_about_title">Om Nova</string>
    <string name="placeholder_about_sub">Nova AI – Kaloriesporing  ·  Version 1.0.0\n\nSkabt med ❤️ for at hjælpe dig med at nå dine sundhedsmål. Nova AI bruger avanceret maskinlæring til at coache dig hvert skridt på vejen.</string>
    <string name="placeholder_settings_title">Indstillinger</string>
    <string name="placeholder_settings_sub">Administrer app-præferencer, måleenheder, tema, sprog og tilsluttede sundhedstjenester som Google Fit eller Apple Health.</string>
    <string name="placeholder_water_title">Vandsporing</string>
    <string name="placeholder_water_sub">Log hvert glas og hold styr på dit daglige hydrerings­mål. Nova AI minder dig om at drikke mere vand, når du er bagud.</string>
    <string name="placeholder_sleep_title">Søvnsporing</string>
    <string name="placeholder_sleep_sub">Spor din søvnlængde og -kvalitet. God søvn er afgørende for vægttab — Nova AI tager din hvile med i betragtning i den daglige sundhedscoaching.</string>

