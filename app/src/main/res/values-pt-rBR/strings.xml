    <string name="placeholder_calorie_tracker_title">Contador de Calorias</string>
    <string name="placeholder_calorie_tracker_sub">Registre cada refeição, lanche e bebida. Pesquise entre milhões de alimentos ou escaneie códigos de barras para análises nutricionais instantâneas e acompanhamento de macros.</string>
    <string name="placeholder_meal_suggestions_title">Sugestões de Refeições</string>
    <string name="placeholder_meal_suggestions_sub">Receba ideias de refeições personalizadas da Nova AI com base no seu orçamento calórico, metas de macros, preferências alimentares e o que você já tem na geladeira.</string>
    <string name="placeholder_food_scan_title">Escaneamento de Alimentos com IA</string>
    <string name="placeholder_food_scan_sub">Aponte a câmera para qualquer refeição e a Nova AI identificará instantaneamente os ingredientes, estimará as porções e registrará suas calorias — sem precisar digitar nada.</string>
    <string name="placeholder_streaks_title">Sequências Diárias</string>
