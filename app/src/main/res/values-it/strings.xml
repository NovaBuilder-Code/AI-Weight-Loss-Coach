    <string name="placeholder_calorie_tracker_title">Contacalorie</string>
    <string name="placeholder_calorie_tracker_sub">Registra ogni pasto, spuntino e bevanda. Cerca tra milioni di alimenti o scansiona i codici a barre per analisi nutrizionali istantanee e monitoraggio dei macro.</string>
