    <string name="placeholder_goals_title">Objetivos</string>
    <string name="placeholder_goals_sub">Establece y gestiona tu objetivo de peso, presupuesto calórico diario, meta de pasos y distribución de macros para que Nova AI te oriente en la dirección correcta.</string>
    <string name="placeholder_notifications_title">Notificaciones</string>
    <string name="placeholder_notifications_sub">Personaliza los recordatorios de comidas, alertas de objetivo de pasos, avisos de pesaje y mensajes motivacionales diarios de Nova AI.</string>
    <string name="placeholder_privacy_title">Privacidad</string>
    <string name="placeholder_privacy_sub">Controla tus permisos de datos, gestiona lo que Nova AI aprende sobre ti y revisa nuestras prácticas de datos y política de privacidad.</string>
    <string name="placeholder_help_title">Ayuda y soporte</string>
    <string name="placeholder_help_sub">Consulta las preguntas frecuentes, mira vídeos tutoriales o contacta con nuestro equipo de soporte. Estamos aquí para ayudarte a sacar el máximo partido de Nova AI.</string>
    <string name="placeholder_about_title">Acerca de Nova</string>
    <string name="placeholder_about_sub">Nova AI – Control de calorías  ·  Versión 1.0.0\n\nCreado con ❤️ para ayudarte a alcanzar tus objetivos de salud. Nova AI usa aprendizaje automático avanzado para guiarte en cada paso del camino.</string>
    <string name="placeholder_settings_title">Configuración</string>
    <string name="placeholder_settings_sub">Gestiona las preferencias de la app, unidades de medida, tema, idioma y servicios de salud conectados como Google Fit o Apple Health.</string>
    <string name="placeholder_water_title">Control de hidratación</string>
    <string name="placeholder_water_sub">Registra cada vaso y mantén el control de tu objetivo diario de hidratación. Nova AI te recordará que bebas más agua cuando te quedes atrás.</string>
    <string name="placeholder_sleep_title">Control del sueño</string>
    <string name="placeholder_sleep_sub">Controla la duración y calidad de tu sueño. Dormir bien es fundamental para perder peso — Nova AI tiene en cuenta tu descanso en tu coaching de salud diario.</string>

