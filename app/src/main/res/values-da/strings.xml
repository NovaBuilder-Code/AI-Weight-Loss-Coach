    <string name="placeholder_calorie_tracker_title">Kaloriesporing</string>
    <string name="placeholder_calorie_tracker_sub">Log hvert måltid, snack og drik. Søg blandt millioner af fødevarer eller scan stregkoder for øjeblikkelige næringsanalyser og makrosporing.</string>
